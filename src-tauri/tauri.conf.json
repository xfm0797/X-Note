{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X-Note",
  "version": "0.1.0",
  "identifier": "pw.lovou.xnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "X-Note 笔记",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
