{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "fs（笔记库读写）+ dialog（文件夹选择）+ shell（执行 git）",
  "windows": ["main", "xnote-win-*"],
  "permissions": [
    "fs:default",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-rename", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-stat", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "**" }] },
    "dialog:default",
    { "identifier": "dialog:allow-open" },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "git", "cmd": "git", "args": true }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "git", "cmd": "git", "args": true }]
    },
    { "identifier": "shell:default" },
    "updater:default",
    "process:allow-restart"
  ]
}
